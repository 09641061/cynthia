# Server
PORT=3000
GIN_MODE=release
APP_URL=http://localhost:3000
MIGRATIONS_DIR=migrations

# PostgreSQL
DATABASE_URL=postgres://localhost:5432/takodu?sslmode=disable
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=change-me

# Email (Resend)
RESEND_API_KEY=re_placeholder_change_me
RESEND_FROM=Cynthia <no-reply@example.com>

# Auth & Sessions
SESSION_TTL_MINUTES=30
REFRESH_TTL_DAYS=14
INVITE_TTL_HOURS=72

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=whatsapp_token_placeholder
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=whatsapp_verify_token_placeholder
WHATSAPP_APP_SECRET=whatsapp_app_secret_placeholder

# AI Assistant (DeepSeek; leave DEEPSEEK_API_KEY empty to disable worker)
DEEPSEEK_API_KEY=deepseek_api_key_placeholder
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ASSISTANT_WORKERS=2
